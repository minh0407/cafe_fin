# Deny by default: no Git, credentials, workbooks, DBs, runtime, tests or private docs.
**
!Dockerfile
!pyproject.toml
!uv.lock
!backend/
!backend/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/scripts/
!frontend/scripts/third-party-notices.mjs
!scripts/
!scripts/preview.py
!scripts/preview/
!scripts/preview/nginx.conf
**/__pycache__
**/*.pyc
**/.env*
**/*.db*
**/*.sqlite*
**/*.log
**/*.xlsx
**/*.xlsm
**/*.csv
**/node_modules
**/.venv
**/dist
