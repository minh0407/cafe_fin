{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cafe Fin",
  "version": "0.1.0",
  "identifier": "vn.cafefin.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "Cafe Fin", "width": 1280, "height": 850, "minWidth": 900, "minHeight": 650, "devtools": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/cafe-fin-sidecar"],
    "resources": ["notices/*"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "windows": { "webviewInstallMode": { "type": "offlineInstaller", "silent": true }, "nsis": { "installMode": "currentUser", "languages": ["English"] } }
  }
}
